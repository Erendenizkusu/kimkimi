NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API bu uygulamanın içinde (app/api/*) — ayrı bir sunucu yok.
# Veritabanı (Neon vb. Postgres bağlantı dizini):
DATABASE_URL="postgresql://kimkimi:kimkimi@localhost:5433/kimkimi?schema=public"
# Admin paneli girişindeki JWT imzası (en az 32 karakter):
JWT_SECRET="change-me-in-production-min-32-chars-long-secret"
JWT_EXPIRES_IN="8h"

# Vercel: Project → Settings → Environment Variables (Production)
#   DATABASE_URL   = Neon bağlantı dizini (pooled)
#   JWT_SECRET     = güçlü rastgele değer
#   NEXT_PUBLIC_SITE_URL = https://kimkimi.app
#
# NEXT_PUBLIC_SITE_URL boş bırakılırsa üretim derlemesi lib/config.ts içindeki
# SITE_URL'e (https://kimkimi.app) düşer; geliştirmede localhost'a.

# Ana sayfa kahraman GIF (boş bırakırsan public/media/hero.gif denenir)
# NEXT_PUBLIC_HERO_GIF_URL=https://example.com/my-hero.gif

# API'yi geçici olarak başka bir yerde barındırırsan (normalde BOŞ bırak —
# boşken aynı origin'deki /api kullanılır, soğuk başlangıç olmaz):
# NEXT_PUBLIC_API_URL=https://baska-bir-sunucu.example.com
