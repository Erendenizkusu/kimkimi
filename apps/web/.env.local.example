NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
# Vercel: Project → Settings → Environment Variables (Production)
# NEXT_PUBLIC_SITE_URL=https://senin-proje.vercel.app   (veya özel alan adın)
# NEXT_PUBLIC_API_URL=https://api-sunucun.example.com  (Nest API’nin public URL’si; Oracle yerine Neon+Railway/Render vb.)
# Ana sayfa kahraman GIF (boş bırakırsan public/media/hero.gif denenir)
# NEXT_PUBLIC_HERO_GIF_URL=https://example.com/my-hero.gif
# Tünel (ngrok vb.): arkadaşın tarayıcısından erişilecek web kökü ve herkese açık API kökü (https://... sondaki / olmadan)
# NEXT_PUBLIC_SITE_URL=https://xxxx.ngrok-free.app
# NEXT_PUBLIC_API_URL=https://yyyy.ngrok-free.app
