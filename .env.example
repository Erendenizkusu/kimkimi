# API (apps/api/.env) — kopyala: cp .env.example apps/api/.env
DATABASE_URL="postgresql://kimkimi:kimkimi@localhost:5433/kimkimi?schema=public"
JWT_SECRET="change-me-in-production-min-32-chars-long-secret"
JWT_EXPIRES_IN="8h"
PORT=4000
# Virgülle whitelist. Uzaktan / ngrok denemesi: CORS_ORIGINS=* (yalnızca güvenilir ortamda; üretimde domain listesi kullanın)
CORS_ORIGINS="http://localhost:3000,http://localhost:3001,http://localhost:3002"
