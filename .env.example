# Web + API tek uygulama: apps/web
# Kopyala: cp .env.example apps/web/.env.local
DATABASE_URL="postgresql://kimkimi:kimkimi@localhost:5433/kimkimi?schema=public"
JWT_SECRET="change-me-in-production-min-32-chars-long-secret"
JWT_EXPIRES_IN="8h"
# Yerel geliştirme. Üretimde: https://kimkimi.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin paneli (apps/admin/.env.local) — sondaki /api şart
# Üretimde: https://kimkimi.app/api
API_URL=http://localhost:3000/api
